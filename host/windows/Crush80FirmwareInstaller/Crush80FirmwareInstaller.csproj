<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AssemblyName>Crush80FirmwareInstaller</AssemblyName>
        <RootNamespace>Crush80FirmwareInstaller</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Version>1.0.0</Version>
        <Authors>Wobkey Crush 80 Community</Authors>
        <Description>Configurable USB OTA firmware installer and SignalRGB plugin manager for the Wobkey Crush 80.</Description>
    </PropertyGroup>

    <ItemGroup>
        <None Update="firmware-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\firmware\GPL-COMPLIANCE.md" Link="firmware\GPL-COMPLIANCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\firmware\releases\v1.06\v2_patched.bin" Link="firmware\v2_patched.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\firmware\releases\v1.04\firmware_patched.bin" Link="firmware\firmware_patched.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\plugins\signalrgb\wired\WobkeyCrush80.js" Link="SignalRGB\WobkeyCrush80.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\plugins\signalrgb\wired\WobkeyCrush80_v2.js" Link="SignalRGB\WobkeyCrush80_v2.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\plugins\signalrgb\wireless\WobkeyCrush80Wireless.js" Link="SignalRGB\WobkeyCrush80Wireless.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\plugins\signalrgb\wireless\WobkeyCrush80Wireless_v2.js" Link="SignalRGB\WobkeyCrush80Wireless_v2.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\firmware\releases\v1.06-per-key\firmware_per_key_v2.bin" Link="firmware\firmware_per_key_v2.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\plugins\signalrgb\wired\WobkeyCrush80_v3.js" Link="SignalRGB\WobkeyCrush80_v3.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
        <None Include="..\..\..\plugins\signalrgb\wireless\WobkeyCrush80Wireless_v3.js" Link="SignalRGB\WobkeyCrush80Wireless_v3.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

</Project>
